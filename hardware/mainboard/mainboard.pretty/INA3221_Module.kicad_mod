(footprint "INA3221_Module"
	(version 20240108)
	(generator "moto11")
	(layer "F.Cu")
	(descr "CJMCU-3221 INA3221 3-channel breakout (purple). Socketed via its labeled 1x8 header (2.54mm): VS GND SCL SDA PV CRI WAR TC. Pads 1..8 = those signals in order. Only VS/GND/SCL/SDA are wired on the mainboard; PV/CRI/WAR/TC (open-drain alerts) read over I2C, left unconnected. Channel screw-terminals (CH1/CH2/CH3) on the far edge. Board ~25.4 x 19mm.")
	(tags "INA3221 CJMCU-3221 current sense I2C module")
